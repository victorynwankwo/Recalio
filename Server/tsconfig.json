{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",

    // Environment Settings
    // Using CommonJS (not "type": "module" in package.json), so module + moduleResolution
    // must match — this is what fixes the ".js import" and "must use import" errors.
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    // verbatimModuleSyntax OFF — it enforces strict ESM import/export rules,
    // which conflicts with our CommonJS setup. This was the cause of the red lines.
    "verbatimModuleSyntax": false,
    // esModuleInterop lets you write "import express from 'express'"
    // instead of "import * as express from 'express'" — cleaner ES6-style imports.
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}